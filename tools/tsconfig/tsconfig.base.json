{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@pageflip/core": ["packages/core/src"],
      "@pageflip/react": ["packages/react/src"],
      "@pageflip/theme": ["packages/theme/src"],
      "@pageflip/renderers": ["packages/renderers/src"],
      "@pageflip/web-component": ["packages/web-component/src"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".turbo"]
}
