{
	"name": "pageflip-monorepo",
	"version": "0.0.0",
	"private": true,
	"workspaces": ["packages/*", "apps/*", "tools/*"],
	"scripts": {
		"dev": "turbo run dev --filter=@pageflip/core --filter=@pageflip/react --filter=@pageflip/playground --parallel",
		"dev:core": "turbo run dev --filter=@pageflip/core",
		"dev:react": "turbo run dev --filter=@pageflip/react",
		"dev:playground": "turbo run dev --filter=@pageflip/playground",
		"dev:storybook": "turbo run storybook --filter=@pageflip/react --filter=@pageflip/web-component --parallel",
		"build": "bun run build:core && bun run build:react && bun run build:theme && bun run build:renderers && bun run build:wc",
		"build:core": "turbo run build --filter=@pageflip/core",
		"build:react": "turbo run build --filter=@pageflip/react",
		"build:theme": "turbo run build --filter=@pageflip/theme",
		"build:renderers": "turbo run build --filter=@pageflip/renderers",
		"build:wc": "turbo run build --filter=@pageflip/web-component",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"typecheck": "turbo run typecheck",
		"test": "bun test",
		"test:coverage": "bun test --coverage",
		"test:e2e": "turbo run test:e2e --filter=@pageflip/playground",
		"doctor": "bunx react-doctor",
		"changeset": "bunx changeset",
		"deps:check": "ncu --workspace --peer --filterVersion '^' --reject '@pageflip/*'",
		"deps:check:minor": "ncu --workspace --peer --filterVersion '^' --target minor --reject '@pageflip/*'",
		"deps:check:major": "ncu --workspace --peer --filterVersion '^' --target major --reject '@pageflip/*'",
		"deps:update": "ncu --workspace --peer --filterVersion '^' --reject '@pageflip/*' -u && bun install",
		"deps:update:minor": "ncu --workspace --peer --filterVersion '^' --target minor --reject '@pageflip/*' -u && bun install",
		"deps:update:major": "ncu --workspace --peer --filterVersion '^' --target major --reject '@pageflip/*' -u && bun install",
		"version": "bunx changeset version && bun install",
		"release": "bun run build && bunx changeset publish",
		"clean": "rm -rf node_modules bun.lockb packages/*/dist apps/*/dist .turbo",
		"prepare": "bunx husky install"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@changesets/cli": "2.27.9",
		"@commitlint/cli": "19.5.0",
		"@commitlint/config-conventional": "19.5.0",
		"@playwright/test": "1.48.0",
		"@storybook/addon-essentials": "8.4.0",
		"@storybook/addon-interactions": "8.4.0",
		"@storybook/addon-links": "8.4.0",
		"@storybook/blocks": "8.4.0",
		"@storybook/react": "8.4.0",
		"@storybook/react-vite": "8.4.0",
		"@storybook/test": "8.4.0",
		"@storybook/web-components": "8.4.0",
		"@storybook/web-components-vite": "8.4.0",
		"@typescript-eslint/eslint-plugin": "8.10.0",
		"@typescript-eslint/parser": "8.10.0",
		"eslint": "9.13.0",
		"eslint-plugin-import": "2.31.0",
		"eslint-plugin-jsdoc": "50.4.0",
		"eslint-plugin-react-hooks": "5.0.0",
		"husky": "9.1.6",
		"lint-staged": "15.2.10",
		"react-doctor": "0.2.0",
		"storybook": "8.4.0",
		"turbo": "2.3.0",
		"typescript": "5.6.3",
		"vitest": "2.1.3",
		"@vitest/coverage-v8": "2.1.3",
		"npm-check-updates": "17.1.0"
	},
	"trustedDependencies": ["@biomejs/biome", "@playwright/test", "husky"],
	"packageManager": "bun@1.4.0",
	"lint-staged": {
		"*.{ts,tsx,js,jsx,json,css}": [
			"biome check --write --files-ignore-unknown=true"
		]
	}
}
