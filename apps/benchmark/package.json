{
	"name": "@pageflip/benchmark",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"build": "bun build src/index.ts --outdir dist --target bun --external \"@pageflip/*\"",
		"lint": "biome check . && bunx eslint . --ext .ts",
		"lint:fix": "biome check --write . && bunx eslint . --ext .ts --fix",
		"typecheck": "tsc --noEmit",
		"test": "bun run src/index.ts",
		"test:coverage": "bun run src/index.ts"
	},
	"devDependencies": {
		"@pageflip/biome-config": "workspace:*",
		"@pageflip/eslint-config": "workspace:*",
		"@pageflip/tsconfig": "workspace:*",
		"typescript": "5.6.3"
	}
}
