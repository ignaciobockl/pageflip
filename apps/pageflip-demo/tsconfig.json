{
	"extends": "@pageflip/tsconfig/tsconfig.lib.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"baseUrl": ".",
		"paths": {
			"@pageflip/core": ["../../packages/core/src"],
			"@pageflip/react": ["../../packages/react/src"],
			"@pageflip/theme": ["../../packages/theme/src"]
		}
	},
	"include": ["src/**/*", "vite.config.ts"],
	"exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx"]
}
