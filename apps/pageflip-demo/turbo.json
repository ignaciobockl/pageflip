{
	"extends": ["//"],
	"tasks": {
		"build": {
			"outputs": ["dist/**"],
			"cache": true
		},
		"dev": { "cache": false, "persistent": true },
		"lint": { "outputs": [], "cache": true },
		"lint:fix": { "cache": false },
		"typecheck": { "cache": true },
		"test": { "outputs": ["coverage/**"], "cache": true },
		"test:e2e": { "cache": false }
	}
}
