{
	"name": "@pageflip/demo",
	"version": "0.1.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"lint": "biome check . && bunx eslint .",
		"lint:fix": "biome check --write . && bunx eslint . --fix",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"test:coverage": "bun test --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui"
	},
	"dependencies": {
		"@pageflip/core": "workspace:*",
		"@pageflip/react": "workspace:*",
		"@pageflip/theme": "workspace:*",
		"react": "18.3.0",
		"react-dom": "18.3.0"
	},
	"devDependencies": {
		"@pageflip/tsconfig": "workspace:*",
		"@pageflip/biome-config": "workspace:*",
		"@pageflip/eslint-config": "workspace:*",
		"@playwright/test": "1.48.0",
		"@types/react": "18.3.0",
		"@types/react-dom": "18.3.0",
		"@vitejs/plugin-react": "4.3.0",
		"typescript": "5.6.3",
		"vite": "5.4.0"
	}
}
