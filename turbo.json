{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "storybook-static/**", ".turbo/**"],
			"cache": true
		},
		"build:watch": { "cache": false, "persistent": true },
		"dev": { "cache": false, "persistent": true },
		"lint": { "outputs": [], "cache": true },
		"lint:fix": { "cache": false },
		"typecheck": { "dependsOn": ["^build"], "cache": true },
		"test": {
			"dependsOn": ["build"],
			"outputs": ["coverage/**"],
			"cache": true
		},
		"test:coverage": {
			"dependsOn": ["build"],
			"outputs": ["coverage/**"],
			"cache": true
		},
		"test:e2e": { "dependsOn": ["build"], "cache": false },
		"test:e2e:headed": { "dependsOn": ["build"], "cache": false },
		"test:e2e:ui": { "dependsOn": ["build"], "cache": false },
		"storybook": { "cache": false, "persistent": true },
		"build-storybook": {
			"dependsOn": ["^build"],
			"outputs": ["storybook-static/**"],
			"cache": true
		},
		"doctor": { "cache": false },
		"clean": { "cache": false }
	},
	"globalEnv": ["NODE_ENV", "CI"]
}
